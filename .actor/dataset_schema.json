{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "actorSpecification": 1,
    "title": "Dataset Schema",
    "fields": {
        "type": "object",
        "properties": {
            "source": { "title": "Source", "type": "string", "description": "uspto_ptab or epo_opposition" },

            "trialNumber": { "title": "PTAB Trial Number", "type": ["string", "null"], "description": "uspto_ptab only, e.g. IPR2024-00123" },
            "trialTypeCode": { "title": "Trial Type", "type": ["string", "null"], "description": "uspto_ptab only: IPR / PGR / CBM / DER" },
            "trialStatusCategory": { "title": "Trial Status", "type": ["string", "null"], "description": "uspto_ptab only" },
            "petitionFilingDate": { "title": "Petition Filing Date", "type": ["string", "null"], "description": "uspto_ptab only" },
            "accordedFilingDate": { "title": "Accorded Filing Date", "type": ["string", "null"], "description": "uspto_ptab only" },
            "institutionDecisionDate": { "title": "Institution Decision Date", "type": ["string", "null"], "description": "uspto_ptab only" },
            "latestDecisionDate": { "title": "Latest Decision Date", "type": ["string", "null"], "description": "uspto_ptab only" },
            "terminationDate": { "title": "Termination Date", "type": ["string", "null"], "description": "uspto_ptab only" },
            "trialLastModifiedDateTime": { "title": "Trial Last Modified", "type": ["string", "null"], "description": "uspto_ptab only" },
            "fileDownloadURI": { "title": "Document Download URI", "type": ["string", "null"], "description": "uspto_ptab only" },
            "patentNumber": { "title": "Challenged Patent Number", "type": ["string", "null"], "description": "uspto_ptab only" },
            "applicationNumberText": { "title": "Application Number", "type": ["string", "null"], "description": "uspto_ptab only" },
            "patentOwnerName": { "title": "Patent Owner Name", "type": ["string", "null"], "description": "uspto_ptab only" },
            "patentOwnerRealPartyInInterestName": { "title": "Patent Owner Real Party in Interest", "type": ["string", "null"], "description": "uspto_ptab only" },
            "petitionerRealPartyInInterestName": { "title": "Petitioner Real Party in Interest", "type": ["string", "null"], "description": "uspto_ptab only" },
            "petitionerCounselName": { "title": "Petitioner Counsel", "type": ["string", "null"], "description": "uspto_ptab only" },
            "inventorName": { "title": "Inventor Name", "type": ["string", "null"], "description": "uspto_ptab only" },
            "technologyCenterNumber": { "title": "Technology Center", "type": ["string", "null"], "description": "uspto_ptab only" },

            "publicationNumber": { "title": "EP Publication Number", "type": ["string", "null"], "description": "epo_opposition only" },
            "eventCode": { "title": "Legal Event Code", "type": ["string", "null"], "description": "epo_opposition only" },
            "eventDescription": { "title": "Legal Event Description", "type": ["string", "null"], "description": "epo_opposition only" },
            "eventDate": { "title": "Legal Event Date", "type": ["string", "null"], "description": "epo_opposition only" },
            "eventCountry": { "title": "Legal Event Country", "type": ["string", "null"], "description": "epo_opposition only" },

            "record_id": {
                "title": "Record ID",
                "type": "string",
                "description": "trialNumber (uspto_ptab) or a composed publicationNumber:eventCode:eventDate key (epo_opposition) - stable across runs"
            },
            "event_type": {
                "title": "Event Type",
                "type": "string",
                "description": "SANCTION (first seen), UPDATED (status/decision changed since last run), TERMINATED (uspto_ptab only - the trial's terminationDate transitioned from unset to set since it was last seen, a more specific signal than a generic UPDATED), or SNAPSHOT_NO_DIFF (unchanged, re-emitted because onlyNew=false)"
            },
            "scraped_at": { "title": "Scraped At", "type": "string", "description": "ISO-8601 timestamp of this extraction" },
            "is_new": { "title": "Is New", "type": "boolean", "description": "true if not seen in a prior run (delta mode)" },
            "source_url": { "title": "Source URL", "type": ["string", "null"] },
            "recipient_or_defendant_name": { "title": "Patent Owner / Defendant", "type": ["string", "null"] },
            "entity_identifier_native": { "title": "Native Entity Identifier", "type": ["string", "null"] },
            "value_native": { "title": "Value (native)", "type": ["string", "null"] },
            "value_currency": { "title": "Value Currency", "type": ["string", "null"] },
            "value_usd_normalized": { "title": "Value (USD)", "type": ["number", "null"] },
            "effective_date_iso": { "title": "Effective Date", "type": ["string", "null"] },
            "publish_date_iso": { "title": "Publish Date", "type": ["string", "null"] },
            "category_or_type": { "title": "Category / Type", "type": ["string", "null"] },
            "status_or_estado": { "title": "Status", "type": ["string", "null"] },
            "awarding_or_regulating_agency": { "title": "Regulating Agency", "type": ["string", "null"] },
            "jurisdiction": { "title": "Jurisdiction", "type": "string", "description": "US or EP" },
            "source_document_url": { "title": "Source Document URL", "type": ["string", "null"] },
            "reference_number": { "title": "Reference Number", "type": ["string", "null"] }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "source",
                    "record_id",
                    "event_type",
                    "recipient_or_defendant_name",
                    "category_or_type",
                    "status_or_estado",
                    "effective_date_iso",
                    "jurisdiction",
                    "awarding_or_regulating_agency"
                ]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "label": "Source", "format": "text", "field": "source" },
                    { "label": "Record ID", "format": "text", "field": "record_id" },
                    { "label": "Event Type", "format": "text", "field": "event_type" },
                    { "label": "Patent Owner / Defendant", "format": "text", "field": "recipient_or_defendant_name" },
                    { "label": "Category", "format": "text", "field": "category_or_type" },
                    { "label": "Status", "format": "text", "field": "status_or_estado" },
                    { "label": "Effective Date", "format": "text", "field": "effective_date_iso" },
                    { "label": "Jurisdiction", "format": "text", "field": "jurisdiction" },
                    { "label": "Agency", "format": "text", "field": "awarding_or_regulating_agency" }
                ]
            }
        }
    }
}
